<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>Marquee links</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>moviebook</string>
			</array>
		</dict>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- plexnfc and Jellyfin are usually plain http on the home network -->
		<key>NSAllowsLocalNetworking</key>
		<true/>
		<key>NSAllowsArbitraryLoadsForMedia</key>
		<true/>
	</dict>
	<!-- Only Apple's built-in HTTPS; no other encryption (App Store export compliance) -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- plexnfc announces itself with Bonjour, so the server can be picked from a list -->
	<key>NSBonjourServices</key>
	<array>
		<string>_moviebook._tcp</string>
	</array>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Marquee connects to your Movie Book server on your home network to show and play your movies.</string>
</dict>
</plist>
