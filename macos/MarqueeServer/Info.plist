<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- A menu bar app: no Dock icon -->
	<key>LSUIElement</key>
	<true/>
	<!-- plexnfc announces itself to the Marquee apps, and finds and opens Marquee on Apple TVs -->
	<key>NSBonjourServices</key>
	<array>
		<string>_moviebook._tcp</string>
		<string>_companion-link._tcp</string>
		<string>_airplay._tcp</string>
		<string>_mediaremotetv._tcp</string>
		<string>_raop._tcp</string>
		<string>_device-info._tcp</string>
	</array>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Marquee Server talks to Plex, your Apple TVs and your phones on your home network.</string>
</dict>
</plist>
