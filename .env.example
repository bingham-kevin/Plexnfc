# Your Plex Media Server, reachable from wherever plexnfc runs
PLEX_URL=http://192.168.1.10:32400
# How to find it: https://support.plex.tv/articles/204059436
# Optional: leave out and use "Sign in with Plex" on the server's home page instead
PLEX_TOKEN=your-plex-token
# Name of the movie library to use
PLEX_LIBRARY=Movies
# Player to start movies on, exactly as it appears in Plex (e.g. "Living Room TV")
PLEX_CLIENT=Living Room
# Optional Home Assistant script started once a movie has been sent to the player,
# e.g. one that presses Menu on the Apple TV remote to hide Swiftfin's controls
#HA_STARTED_SCRIPT=script.movie_night_started
# Optional: play on a Jellyfin app (e.g. Swiftfin on Apple TV) instead of PLEX_CLIENT.
# Plex still makes the book; the movie is matched in Jellyfin by title, year and TMDB ID.
#JELLYFIN_URL=http://192.168.1.10:8096
#JELLYFIN_API_KEY=
#JELLYFIN_PLAYER=AppleTV
# Base URL that gets written onto the NFC tags. Must be reachable from your phone.
# Use a fixed IP / hostname for this machine so the tags never need rewriting.
PUBLIC_BASE_URL=http://192.168.1.20:8080
# Resume where you left off (true) or always start from the beginning (false)
RESUME=true

# ---- Optional: Home Assistant ----------------------------------------------
# Before playing, run a Home Assistant script that turns the TV on, switches
# the HDMI input and opens Plex. See docs/home-assistant.md for examples.
#HA_URL=http://homeassistant.local:8123
# Profile -> Security -> Long-lived access tokens
#HA_TOKEN=your-long-lived-token
#HA_SCRIPT=script.movie_night
# Optional script for the /off control tag (e.g. turn the TV off)
#HA_OFF_SCRIPT=script.movie_night_off
# Let Home Assistant start the movie too (via its Plex integration) instead of
# plexnfc talking to the player directly. Set to the Plex media_player entity,
# e.g. the one HA's Plex integration creates for your Apple TV.
#HA_PLAYER=media_player.plex_plex_for_apple_tv_living_room
# Seconds to wait for the Plex player to show up after the script runs
#PLAYER_WAIT=45
