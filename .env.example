# Settings for running Marquee Server with Docker or Python (python -m plexnfc.server).
# The Marquee Server Mac app sets these itself; an optional .env in its Application
# Support folder can add the optional ones below.

# Your Plex Media Server. Leave PLEX_URL out to use the server on your Plex account.
PLEX_URL=http://192.168.1.10:32400
# Optional: leave out and use "Sign in with Plex" in the control panel instead.
# How to find it: https://support.plex.tv/articles/204059436
PLEX_TOKEN=your-plex-token
# Name of the movie library to use
PLEX_LIBRARY=Movies
# The Marquee player (the name it was approved under in the control panel) that taps
# go to when a tag doesn't say. Movies play in the Marquee app on Apple TV.
APP_PLAYER=Living Room
# Base URL that gets written onto the NFC tags. Must be reachable from your phone.
# Use a fixed IP / hostname for this machine so the tags never need rewriting.
PUBLIC_BASE_URL=http://192.168.1.20:8080
# Resume where you left off (true) or always start from the beginning (false)
RESUME=true

# ---- Optional: Home Assistant ----------------------------------------------
# For an Apple TV paired in the control panel, Marquee Server wakes it and opens
# Marquee itself. Otherwise it can run a Home Assistant script first that turns the
# TV on and opens Marquee. See docs/home-assistant.md for examples.
#HA_URL=http://homeassistant.local:8123
# Profile -> Security -> Long-lived access tokens
#HA_TOKEN=your-long-lived-token
#HA_SCRIPT=script.movie_night
# Get-ready scripts for players other than the default one (HA_SCRIPT only runs for
# the default player), as "player = script" separated by semicolons.
#PLAYER_SCRIPTS=Living Room = script.living_room_movie; Den = script.den_movie
# Optional script started once a movie has been sent to Marquee
#HA_STARTED_SCRIPT=script.movie_night_started
# Optional script for the /off control tag (e.g. turn the TV off)
#HA_OFF_SCRIPT=script.movie_night_off

# ---- Optional: Music Assistant, for the Music section and music cards -------
# Usually set in the control panel (Music -> Sources -> Music Assistant) instead.
# Without it, music cards go through the Marquee integration in Home Assistant.
#MUSIC_ASSISTANT_URL=http://homeassistant.local:8095
# Music Assistant -> Settings -> Profile -> Long-lived access tokens
#MUSIC_ASSISTANT_TOKEN=your-music-assistant-token

# ---- Optional: Audiobookshelf, for the Books section and book cards --------
# Usually set in the control panel (Books -> Sources) instead.
#AUDIOBOOKSHELF_URL=http://nas.local:13378
# Audiobookshelf -> Settings -> API Keys
#AUDIOBOOKSHELF_TOKEN=your-audiobookshelf-api-key
